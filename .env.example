# Browser-facing ECCS API base. Committed .env uses the local Spring backend.
# Production builds override this in .env.production (and the Docker image)
# with the same-origin proxy path.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/eccs

# Server-side only. Read by app/api/eccs/[...path]/route.ts.
# Docker default (also set in the image): http://host.docker.internal:8080
# The container must be started with --add-host=host.docker.internal:host-gateway.
# For `pnpm start` on the host, point this at the backend directly:
# BACKEND_URL=http://localhost:8080
BACKEND_URL=http://host.docker.internal:8080
